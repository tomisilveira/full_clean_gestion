{
  "name": "full-clean-backend",
  "version": "1.0.0",
  "description": "Backend para Sistema de Gestión Full Clean",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "ts-node-dev prisma/seed.ts",
    "seed:prod": "ts-node prisma/seed.ts",
    "start:prod": "npx prisma migrate deploy && npm run seed:prod && node dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@afipsdk/afip.js": "^0.7.3",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "mercadopago": "^2.3.0",
    "multer": "^2.2.0",
    "node-thermal-printer": "^4.4.0",
    "pdfkit": "^0.15.0",
    "qrcode": "^1.5.4",
    "ts-node": "^10.9.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.9.0",
    "@types/pdfkit": "^0.13.5",
    "@types/qrcode": "^1.5.5",
    "prisma": "^5.22.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
