# Copiar este archivo a backend/.env y completar los valores. El .env real NO se versiona.

# Servidor
PORT=4000
NODE_ENV=development

# Base de datos (PostgreSQL)
DATABASE_URL="postgresql://USUARIO:CONTRASENA@127.0.0.1:5432/fullclean_dev?schema=public"

# JWT — OBLIGATORIO en todos los entornos (el servidor no arranca sin esto).
# Generar uno aleatorio, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Seed (datos iniciales). En desarrollo, si no se definen, se usan las contraseñas demo
# admin123 / vendedor123. En producción, si no se define SEED_ADMIN_PASSWORD se genera una
# aleatoria y se imprime una única vez en el log del primer arranque.
# SEED_ADMIN_PASSWORD=
# SEED_VENDEDOR_PASSWORD=
# En producción: crear también el catálogo de ejemplo y el vendedor demo (p. ej. para una demo pública).
# SEED_DEMO_DATA=true

# CORS (opcional): orígenes separados por coma, solo si el frontend se deploya aparte.
# FRONTEND_URL=https://mi-frontend.example.com

# ARCA / AFIP — normalmente no hace falta tocar nada acá (el CUIT y los certificados se
# cargan desde Configuración → Empresa). Son overrides opcionales para deploys avanzados.
AFIP_PRODUCTION=false
# AFIP_CUIT=
# AFIP_CERT_PATH=
# AFIP_KEY_PATH=

# Mercado Pago
# MP_ACCESS_TOKEN=
# MP_WEBHOOK_URL=https://TU_DOMINIO/api/mercadopago/webhook
