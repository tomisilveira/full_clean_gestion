{
  "name": "full-clean-gestion",
  "version": "1.0.0",
  "description": "Sistema Integral de Gestión Comercial para Artículos de Limpieza (Full Clean)",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "install:all": "npm install --workspace=backend && npm install --workspace=frontend",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "seed": "npm --prefix backend run prisma:seed",
    "test:backend": "npm --prefix backend test",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm run install:all && npm run build:frontend && npm --prefix backend run build",
    "start": "npm --prefix backend run start:prod"
  }
}
