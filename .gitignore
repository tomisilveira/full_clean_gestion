# Node
node_modules/
dist/
build/

# Lockfile: se generó en Windows y algunos paquetes (rollup, usado por Vite) tienen
# binarios nativos distintos por SO — un lockfile de Windows rompe el install en Linux
# (bug conocido: npm/cli#4828). Cada entorno resuelve el suyo con "npm install".
package-lock.json

# Env (el .env.example sí se versiona: no tiene valores reales)
.env
.env.*
!.env.example

# SQLite DB legado (el sistema ahora usa PostgreSQL, se deja por si queda algún archivo local viejo)
backend/prisma/dev.db
backend/prisma/dev.db-journal
backend/prisma/dev.db-shm
backend/prisma/dev.db-wal

# Certificados ARCA (nunca versionar keys privadas)
backend/certs/*.key
backend/certs/*.crt
backend/certs/*.pem
backend/certs/*.csr
backend/certs/*.pfx
backend/certs/*.p12

# Logs
*.log
logs/
backups/*.sql
backups/*.zip

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/settings.json
.idea/
.claude/settings.local.json

# Vite cache
.vite/
frontend/.vite/
frontend/dist/
