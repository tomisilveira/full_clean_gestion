# Render (y otros hosts que setean NODE_ENV=production durante el build) hacen que
# "npm install" omita las devDependencies por defecto. Acá viven vite, typescript,
# tailwindcss, etc., que son imprescindibles para compilar (aunque no para correr
# después de compilado). Esta línea fuerza a npm a instalarlas siempre.
production=false
